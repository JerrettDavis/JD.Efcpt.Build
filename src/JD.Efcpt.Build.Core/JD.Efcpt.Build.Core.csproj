<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Multi-target to match every consumer: JD.Efcpt.Build.Tasks (MSBuild task host) and the
      jd-efcpt dotnet-tool CLI (net8.0). This assembly holds the reusable, MSBuild-independent
      core logic (logging abstraction, config generation, diagnostics, connection-string
      resolution, process execution) shared between the MSBuild task pipeline and the CLI.
    -->
    <TargetFrameworks>net472;net8.0;net9.0;net10.0</TargetFrameworks>

    <!--
      Not packed as its own NuGet package. This assembly is a build-time/runtime implementation
      detail shared between JD.Efcpt.Build.Tasks and JD.Efcpt.Cli via ProjectReference; its output
      DLL travels to Tasks consumers by being swept up alongside JD.Efcpt.Build.Tasks.dll
      (CopyLocalLockFileAssemblies) into the existing tasks/{tfm} pack glob in
      JD.Efcpt.Build.csproj, and is a normal dependency for the CLI's dotnet-tool package.
    -->
    <IsPackable>false</IsPackable>

    <AssemblyName>JD.Efcpt.Build.Core</AssemblyName>
    <RootNamespace>JD.Efcpt.Build.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <LangVersion>latest</LangVersion>

    <!-- Disable nullable and some warnings for net472, matching JD.Efcpt.Build.Tasks -->
    <Nullable Condition="'$(TargetFramework)' == 'net472'">annotations</Nullable>
    <NoWarn Condition="'$(TargetFramework)' == 'net472'">$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>

  <!-- Polyfills for net472: provides IsExternalInit, init accessors, etc. (records use these). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PatternKit.Core" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JD.Efcpt.Build.Providers.Abstractions\JD.Efcpt.Build.Providers.Abstractions.csproj" />
  </ItemGroup>
</Project>
