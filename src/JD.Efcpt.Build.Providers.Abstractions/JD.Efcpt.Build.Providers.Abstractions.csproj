<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Multi-target to match every consumer: JD.Efcpt.Build.Tasks (bundled SQL Server) and
      every satellite provider project (JD.Efcpt.Build.PostgreSQL, .MySQL, .Sqlite, .Oracle,
      .Firebird, .Snowflake). All of them must be able to cast a reflection-loaded adapter to
      IProviderAdapter, which requires the exact same assembly identity across load contexts -
      see ProviderAdapterResolver's remarks for why this assembly exists.
    -->
    <TargetFrameworks>net472;net8.0;net9.0;net10.0</TargetFrameworks>

    <!--
      Referenceable as its own NuGet package (#184): third-party authors implementing a custom
      database provider (IProviderAdapter + ISchemaReader) need something installable to compile
      against, without pulling in all of JD.Efcpt.Build.Tasks. This assembly remains the shared
      contract between the core Tasks assembly and every satellite provider project (both
      first-party, via ProjectReference, and third-party custom providers, via PackageReference);
      its output DLL still also travels to JD.Efcpt.Build.Tasks consumers by being swept up
      alongside JD.Efcpt.Build.Tasks.dll (CopyLocalLockFileAssemblies) into the existing
      tasks/{tfm} pack glob in JD.Efcpt.Build.csproj - packing this project does not change that,
      since IncludeBuildOutput/CopyLocalLockFileAssemblies behavior is independent of IsPackable.
      AssemblyName and RootNamespace are kept exactly as they were so the reflective adapter cast
      in ProviderAdapterResolver.CreateAdapterInstance continues to see the same assembly
      identity across every load context.
    -->
    <IsPackable>true</IsPackable>

    <AssemblyName>JD.Efcpt.Build.Providers.Abstractions</AssemblyName>
    <RootNamespace>JD.Efcpt.Build.Tasks.Schema</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <LangVersion>latest</LangVersion>

    <!-- Disable nullable and some warnings for net472, matching JD.Efcpt.Build.Tasks -->
    <Nullable Condition="'$(TargetFramework)' == 'net472'">annotations</Nullable>
    <NoWarn Condition="'$(TargetFramework)' == 'net472'">$(NoWarn);CS8632</NoWarn>

    <!-- Package Identity (#184: referenceable contract package for custom provider authors) -->
    <PackageId>JD.Efcpt.Build.Providers.Abstractions</PackageId>
    <Authors>Jerrett Davis</Authors>
    <Company>JDH Productions</Company>
    <Title>JD.Efcpt.Build Custom Provider Contract</Title>
    <Description>Contract for authoring custom JD.Efcpt.Build database providers</Description>
    <PackageTags>efcore;entity-framework;ef-core-power-tools;efcpt;msbuild;database-first;provider;plugin</PackageTags>
    <PackageProjectUrl>https://github.com/jerrettdavis/JD.Efcpt.Build</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jerrettdavis/JD.Efcpt.Build</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- Polyfills for net472: provides IsExternalInit, init accessors, etc. (records use these). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    DataTable.AsEnumerable()/CopyToDataTable() live in System.Data.DataSetExtensions, which is
    not part of the default net472 reference set. JD.Efcpt.Build.Tasks gets this transitively
    via its database driver packages; this assembly has no such package to piggyback on, so it
    must be referenced explicitly.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>
</Project>
