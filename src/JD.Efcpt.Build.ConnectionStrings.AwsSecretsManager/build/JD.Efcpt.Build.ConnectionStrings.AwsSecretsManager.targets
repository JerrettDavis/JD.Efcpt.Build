<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Appends this package's deployed connection-string-source directory to
    @(EfcptConnectionStringSourceSearchPath), which ResolveSqlProjAndInputs (in
    JD.Efcpt.Build.Tasks, via SatelliteConnectionStringSourceResolver) reads to locate
    JD.Efcpt.Build.ConnectionStrings.AwsSecretsManager.dll at build time.

    This computes its own tasks-folder selection instead of depending on $(_EfcptTasksFolder)
    (set by JD.Efcpt.Build.targets) being evaluated first: NuGet does not guarantee this
    package's build/ import runs after the core package's, so this mirrors that same
    MSBuildRuntimeType/MSBuildVersion selection logic independently, reusing $(_EfcptTasksFolder)
    when it happens to already be set to avoid recomputation.
  -->
  <PropertyGroup>
    <_EfcptAwsSecretsManagerTasksFolder Condition="'$(_EfcptAwsSecretsManagerTasksFolder)' == '' and '$(_EfcptTasksFolder)' != ''">$(_EfcptTasksFolder)</_EfcptAwsSecretsManagerTasksFolder>
    <_EfcptAwsSecretsManagerTasksFolder Condition="'$(_EfcptAwsSecretsManagerTasksFolder)' == '' and '$(MSBuildRuntimeType)' == 'Core' and $([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '17.14'))">net10.0</_EfcptAwsSecretsManagerTasksFolder>
    <_EfcptAwsSecretsManagerTasksFolder Condition="'$(_EfcptAwsSecretsManagerTasksFolder)' == '' and '$(MSBuildRuntimeType)' == 'Core' and $([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '17.12'))">net9.0</_EfcptAwsSecretsManagerTasksFolder>
    <_EfcptAwsSecretsManagerTasksFolder Condition="'$(_EfcptAwsSecretsManagerTasksFolder)' == '' and '$(MSBuildRuntimeType)' == 'Core'">net8.0</_EfcptAwsSecretsManagerTasksFolder>
    <_EfcptAwsSecretsManagerTasksFolder Condition="'$(_EfcptAwsSecretsManagerTasksFolder)' == ''">net472</_EfcptAwsSecretsManagerTasksFolder>
    <_EfcptAwsSecretsManagerSourceDir>$(MSBuildThisFileDirectory)..\tasks\$(_EfcptAwsSecretsManagerTasksFolder)\connstr-sources\aws-secrets</_EfcptAwsSecretsManagerSourceDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(_EfcptAwsSecretsManagerSourceDir)')">
    <EfcptConnectionStringSourceSearchPath Include="$(_EfcptAwsSecretsManagerSourceDir)" />
  </ItemGroup>
</Project>
