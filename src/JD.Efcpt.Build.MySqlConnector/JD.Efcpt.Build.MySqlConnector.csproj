<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-target to match JD.Efcpt.Build.Tasks so the adapter loads under any supported MSBuild host. -->
    <TargetFrameworks>net472;net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>

    <AssemblyName>JD.Efcpt.Build.MySqlConnector</AssemblyName>
    <RootNamespace>JD.Efcpt.Build.Tasks.Schema.Providers</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>

    <Nullable Condition="'$(TargetFramework)' == 'net472'">annotations</Nullable>
    <NoWarn Condition="'$(TargetFramework)' == 'net472'">$(NoWarn);CS8632</NoWarn>

    <!--
      This assembly is never referenced at compile time by a consuming project - it's located by
      ProviderAdapterResolver and loaded via reflection at MSBuild task-execution time (see
      IncludeMySqlConnectorProviderAssembliesInPack below). So it must NOT go into the standard
      lib/ NuGet folder (which would make it a compile-time reference), and its own driver package
      (MySqlConnector) must NOT be declared as a NuGet dependency of this package - its DLLs are
      bundled directly instead.
    -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Package Identity -->
    <PackageId>JD.Efcpt.Build.MySqlConnector</PackageId>
    <Title>JD.Efcpt.Build MySQL/MariaDB Provider</Title>
    <Authors>Jerrett Davis</Authors>
    <Company>JDH Productions</Company>
    <Description>MySQL/MariaDB database provider driver for JD.Efcpt.Build. Install alongside JD.Efcpt.Build and set EfcptProvider=mysql to scaffold EF Core models from a MySQL or MariaDB database during your build. See https://jerrettdavis.github.io/JD.Efcpt.Build/user-guide/provider-support.html for the full dependency chain (JD.Efcpt.Build.MySqlConnector -> MySqlConnector).</Description>
    <PackageTags>efcore;entity-framework;efcpt;msbuild;mysql;mariadb;database-first;code-generation</PackageTags>
    <PackageProjectUrl>https://github.com/jerrettdavis/JD.Efcpt.Build</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jerrettdavis/JD.Efcpt.Build</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared IProviderAdapter/ISchemaReader contracts - see that project's remarks. -->
    <ProjectReference Include="..\JD.Efcpt.Build.Providers.Abstractions\JD.Efcpt.Build.Providers.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

  <!-- Polyfills for net472: provides IsExternalInit, init accessors, etc. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- DataTable.AsEnumerable() lives in System.Data.DataSetExtensions, not part of the default
       net472 reference set - see JD.Efcpt.Build.Providers.Abstractions.csproj for the same fix. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="build\JD.Efcpt.Build.MySqlConnector.targets" Pack="true" PackagePath="build" />
  </ItemGroup>

  <!--
    Collect this project's own build output (the adapter DLL + MySqlConnector and its transitive
    dependencies) into tasks/{tfm}/providers/mysql inside the nupkg, mirroring how
    JD.Efcpt.Build.csproj collects JD.Efcpt.Build.Tasks's output into tasks/{tfm}. The shared
    Providers.Abstractions DLL is deliberately excluded: it already ships inside the core
    JD.Efcpt.Build package next to JD.Efcpt.Build.Tasks.dll, and by the time
    ProviderAdapterResolver resolves any provider (including this one) that copy is already
    loaded in the same load context/AppDomain, so a second copy here would be redundant, unused
    weight.
  -->
  <Target Name="IncludeMySqlConnectorProviderAssembliesInPack" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <_MySqlConnectorProviderFiles Include="bin\$(Configuration)\net472\*.dll" Condition="Exists('bin\$(Configuration)\net472\JD.Efcpt.Build.MySqlConnector.dll')" TargetFrameworkFolder="net472" />
      <_MySqlConnectorProviderFiles Include="bin\$(Configuration)\net8.0\*.dll" Condition="Exists('bin\$(Configuration)\net8.0\JD.Efcpt.Build.MySqlConnector.dll')" TargetFrameworkFolder="net8.0" />
      <_MySqlConnectorProviderFiles Include="bin\$(Configuration)\net9.0\*.dll" Condition="Exists('bin\$(Configuration)\net9.0\JD.Efcpt.Build.MySqlConnector.dll')" TargetFrameworkFolder="net9.0" />
      <_MySqlConnectorProviderFiles Include="bin\$(Configuration)\net10.0\*.dll" Condition="Exists('bin\$(Configuration)\net10.0\JD.Efcpt.Build.MySqlConnector.dll')" TargetFrameworkFolder="net10.0" />
      <_MySqlConnectorProviderFiles Remove="@(_MySqlConnectorProviderFiles)" Condition="'%(Filename)' == 'JD.Efcpt.Build.Providers.Abstractions'" />
      <None Include="@(_MySqlConnectorProviderFiles)" Pack="true" PackagePath="tasks\%(_MySqlConnectorProviderFiles.TargetFrameworkFolder)\providers\mysql" />
    </ItemGroup>
  </Target>
</Project>
