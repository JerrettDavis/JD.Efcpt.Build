<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AWSSDK.Core" Version="4.1.1.2" />
    <PackageVersion Include="AWSSDK.SecretsManager" Version="4.1.1.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="JD.MSBuild.Fluent" Version="1.3.39" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.1" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <!-- Pin transitive Pkcs to patched version: GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.12.2" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.12.2" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.15" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.12.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="MySqlConnector" Version="3.0.0" />
    <PackageVersion Include="Npgsql" Version="9.0.5" />
    <PackageVersion Include="Oracle.ManagedDataAccess" Version="23.26.100" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.100" />
    <PackageVersion Include="PatternKit.Core" Version="0.147.37" />
    <PackageVersion Include="PolySharp" Version="1.17.1" />
    <PackageVersion Include="Snowflake.Data" Version="6.5.0" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="System.IO.Hashing" Version="11.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="System.Text.Json" Version="10.0.14" Condition="'$(TargetFramework)' == 'net472' or '$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net9.0'" />
    <PackageVersion Include="System.Text.Json" Version="11.0.0" Condition="'$(TargetFramework)' != 'net472' and '$(TargetFramework)' != 'net8.0' and '$(TargetFramework)' != 'net9.0'" />
    <PackageVersion Include="Testcontainers.FirebirdSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.Oracle" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="TinyBDD.Xunit" Version="0.19.48" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
