<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EfcptProvider>sqlite</EfcptProvider>
    <EfcptEnabled Condition="'$(EfcptConnectionString)' == ''">false</EfcptEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JD.Efcpt.Build" Version="*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="JD.Efcpt.Build.Sqlite" Version="*" Condition="'$(EfcptEnabled)' != 'false'" />
  </ItemGroup>
  <ItemGroup Condition="'$(EfcptEnabled)' != 'false'">
    <Compile Remove="Generated/**/*.cs" />
  </ItemGroup>
</Project>
